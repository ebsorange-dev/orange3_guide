# docker-compose 가 참조하는 환경변수 템플릿. 실제 값은 .env 에 채우세요(.env 는 커밋 금지).

# 호스트 베이스 경로 — 드라이브 문자 소문자 + 앞에 / (예: e:\_26_..._ → /e/_26_..._)
HOST_BASE=/e/_26_Use_Orange_New_set_

# Google Drive OAuth (OPEN 모달의 LOGIN TO GOOGLE 버튼). 비워두면 LOGIN 비활성.
# Google Cloud Console 에서 OAuth 2.0 클라이언트 ID 발급 후 입력.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8888/api/gdrive/callback

# ── 관리자 페이지(/admin/*) Firebase 로그인 (2026-05-30) ──
# 비워두면 인증 비활성(개발 모드). 활성화 절차:
#  1) Firebase 콘솔 → Authentication → 이메일/비밀번호 사용 설정 + 관리자 계정 추가
#  2) 프로젝트 설정 → 웹앱 → config 복사해서 아래 채우기
# FIREBASE_PROJECT_ID: 웹 config 의 projectId (서버 토큰 검증용 — 서비스계정 키 불필요)
FIREBASE_PROJECT_ID=
# FIREBASE_WEB_CONFIG: 웹 config 전체를 한 줄 JSON 으로. 예:
#   {"apiKey":"...","authDomain":"xxx.firebaseapp.com","projectId":"xxx"}
FIREBASE_WEB_CONFIG=
# ADMIN_EMAILS: 허용 관리자 이메일(쉼표구분). 비우면 프로젝트의 모든 계정 허용.
ADMIN_EMAILS=
