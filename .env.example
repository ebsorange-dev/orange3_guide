# docker-compose 가 참조하는 환경변수 템플릿.
# 사용법: cp .env.example .env → 값 수정 후 docker compose up -d
# .env 는 커밋 금지 (.gitignore 에 등록됨 — 시크릿 정보 포함)
#
# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  ★ 실운영 배포 시 반드시 변경 필요한 항목                                    │
# │    HOST_BASE          — 실제 서버 경로로 수정                                │
# │    GOOGLE_OAUTH_*     — Google Cloud Console 에서 발급한 실제 키로 교체      │
# │    FIREBASE_*         — Firebase 콘솔에서 발급한 실제 값으로 교체            │
# │    ADMIN_EMAILS       — 허용할 관리자 이메일 주소로 교체                     │
# └─────────────────────────────────────────────────────────────────────────────┘

# ── 호스트 베이스 경로 ────────────────────────────────────────────────────────
# 드라이브 문자 소문자 + 앞에 / (예: e:\_26_..._ → /e/_26_..._)
# ★ 실운영 시 변경 필요 — 이 값이 data/, sessions/ 등 볼륨 마운트 경로를 결정함
HOST_BASE=/e/_26_Use_Orange_New_set_

# ── Google Drive OAuth ────────────────────────────────────────────────────────
# OPEN 모달의 LOGIN TO GOOGLE 버튼. 비워두면 LOGIN 버튼 비활성.
# ★ 실운영 시 변경 필요 — Google Cloud Console → OAuth 2.0 클라이언트 ID 발급
# · 승인된 리다이렉션 URI: GOOGLE_OAUTH_REDIRECT_URI 와 동일하게 등록
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8888/api/gdrive/callback

# ── 관리자 페이지 Firebase 로그인 (/admin/*) ─────────────────────────────────
# ★ 실운영 시 반드시 변경 필요 — 비워두면 인증 비활성(개발 모드, 누구나 /admin 접근 가능)
# 활성화 절차:
#  1) Firebase 콘솔 → Authentication → 이메일/비밀번호 사용 설정 + 관리자 계정 추가
#  2) 프로젝트 설정 → 웹앱 → config 복사해서 아래 채우기
#  3) ADMIN_EMAILS 에 허용할 관리자 이메일 입력 (비우면 프로젝트 전체 계정 허용)
#
# FIREBASE_PROJECT_ID: 웹 config 의 projectId (서버 토큰 검증용 — 서비스계정 키 불필요)
FIREBASE_PROJECT_ID=
# FIREBASE_WEB_CONFIG: 웹 config 전체를 한 줄 JSON 으로.
# 예: {"apiKey":"...","authDomain":"xxx.firebaseapp.com","projectId":"xxx"}
FIREBASE_WEB_CONFIG=
# ADMIN_EMAILS: 허용 관리자 이메일(쉼표구분). 비우면 프로젝트의 모든 계정 허용.
ADMIN_EMAILS=
