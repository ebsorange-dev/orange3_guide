		<properties node_id="4" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01\xbb\x00\x00\x00\x10\x00\x00\x06F\x00\x00\x04_\x00\x00\x01\xbc\x00\x00\x00.\x00\x00\x06E\x00\x00\x04^\x00\x00\x00\x00\x00\x00\x00\x00\x08\x00\x00\x00\x01\xbc\x00\x00\x00.\x00\x00\x06E\x00\x00\x04^', 'scriptLibrary': [{'name': '데이터 전처리', 'script': "import pandas as pd\nfrom Orange.data import Table, Domain, DiscreteVariable\nfrom sklearn.preprocessing import MultiLabelBinarizer\n\n# 거래-상품 리스트 추출\ntransactions = [(str(row[0]), str(row[1])) for row in in_data if str(row[1]).strip()]\n\n# DataFrame 생성 및 중복 제거\ndf = pd.DataFrame(transactions, columns = ['Transaction', 'Item']).drop_duplicates()\n\n# 거래별 상품 묶기\ngrouped = df.groupby('Transaction')['Item'].apply(list)\n\n# 상위 50개 상품만 추출\nall_items = [item for sublist in grouped for item in sublist]\ntop_items = pd.Series(all_items).value_counts().head(50).index\n\n# 인기 상품만 포함한 거래 만들기\nfiltered = grouped.apply(lambda items: [item for item in items if item in top_items])\nfiltered = filtered[filtered.map(len) &gt; 0]  # 1개 이상 상품 포함된 거래만 유지\n\n# 이진 매트릭스 변환\nmlb = MultiLabelBinarizer()\nX = mlb.fit_transform(filtered)\n\n# Orange용 Table로 변환\ndomain = Domain([DiscreteVariable(name, values=['0', '1']) for name in mlb.classes_])\nout_data = Table.from_numpy(domain, X.astype(float))", 'filename': None}], 'scriptText': "import pandas as pd\nfrom Orange.data import Table, Domain, DiscreteVariable\nfrom sklearn.preprocessing import MultiLabelBinarizer\n\n# 거래-상품 리스트 추출\ntransactions = [(str(row[0]), str(row[1])) for row in in_data if str(row[1]).strip()]\n\n# DataFrame 생성 및 중복 제거\ndf = pd.DataFrame(transactions, columns = ['Transaction', 'Item']).drop_duplicates()\n\n# 거래별 상품 묶기\ngrouped = df.groupby('Transaction')['Item'].apply(list)\n\n# 상위 50개 상품만 추출\nall_items = [item for sublist in grouped for item in sublist]\ntop_items = pd.Series(all_items).value_counts().head(50).index\n\n# 인기 상품만 포함한 거래 만들기\nfiltered = grouped.apply(lambda items: [item for item in items if item in top_items])\nfiltered = filtered[filtered.map(len) &gt; 0]  # 1개 이상 상품 포함된 거래만 유지\n\n# 이진 매트릭스 변환\nmlb = MultiLabelBinarizer()\nX = mlb.fit_transform(filtered)\n\n# Orange용 Table로 변환\ndomain = Domain([DiscreteVariable(name, values=['0', '1']) for name in mlb.classes_])\nout_data = Table.from_numpy(domain, X.astype(float))", 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xad\x00\x00\x00m\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
