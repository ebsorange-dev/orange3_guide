		<properties node_id="5" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01\xb6\x00\x00\x00\xa5\x00\x00\x04\xc2\x00\x00\x04\x00\x00\x00\x01\xb6\x00\x00\x00\xa5\x00\x00\x04\xc2\x00\x00\x04\x00\x00\x00\x00\x00\x00\x00\x00\x00\x08\x00\x00\x00\x01\xb6\x00\x00\x00\xa5\x00\x00\x04\xc2\x00\x00\x04\x00', 'scriptLibrary': [{'name': '손실함수', 'script': "import numpy as np\nimport pandas as pd\nfrom Orange.data import Domain, Table, ContinuousVariable\n\ndata = in_data # [File] 위젯에서 받은 데이터\nX = data.X  # 데이터의 속성 역할이 feature인 경우\ny = data.Y  # 데이터의 속성 역할이 target인 경우\n\n# 다양한 기울기 값 테스트\nslopes = np.linspace(0.0, 3.0, 10)\nmse_values = []\n\nfor w in slopes:\n    predictions = w * X\n    mse = np.mean((y - predictions) ** 2)\n    mse_values.append(mse)\n\n# 결과 데이터 프레임 생성\nresults = pd.DataFrame({\n    'slope': slopes,\n    'mse': mse_values\n})\n\n# Orange Table로 변환\ndomain = Domain([ContinuousVariable('slope'),\n                 ContinuousVariable('mse')])\nout_data = Table.from_numpy(domain, results.values)", 'filename': None}, {'name': '경사 하강법', 'script': "import numpy as np\nimport pandas as pd\nfrom Orange.data import Table, Domain, ContinuousVariable\n\n# 1. 데이터 정의\ndata = in_data\nX = np.array(data.X).flatten() # shape: (N,)\ny = np.array(data.Y).flatten() # shape: (N,)\nN = len(X)\n\n# 2. 파라미터 초기값\nw = 0.0\nb = 0.0\n\n# 3. 하이퍼파라미터\nalpha = 0.0001 # 학습률\nepochs = 15    # 반복 학습 횟수\n\n# 4. 기록 리스트 (epoch 포함)\nhistory = []\n\n# 5. 경사하강법 루프\nfor epoch in range(epochs):\n    y_pred = w * X + b\n\n    # 편도함수 계산 (수식 그대로)\n    dw = (2/N) * np.sum(-X * (y - y_pred))\n    db = (2/N) * np.sum(-(y - y_pred))\n\n    # 파라미터 업데이트\n    w = w - alpha * dw\n    b = b - alpha * db\n    print(dw)\n\n    # 손실 계산\n    mse = np.mean((y - y_pred) ** 2)\n\n    # 10 epoch마다 기록\n    if epoch % 1 == 0:\n        history.append([epoch+1, w, b, mse])\n\n# 6. DataFrame 변환\nresults = pd.DataFrame(history, columns=['epoch', 'w', 'b', 'mse'])\n\n# 7. Orange Table 변환\ndomain = Domain([\n    ContinuousVariable('epoch'),\n    ContinuousVariable('w'),\n    ContinuousVariable('b'),\n    ContinuousVariable('mse')\n])\nout_data = Table.from_numpy(domain, results.values)\n\n", 'filename': None}], 'scriptText': "import numpy as np\nimport pandas as pd\nfrom Orange.data import Domain, Table, ContinuousVariable\n\ndata = in_data # [File] 위젯에서 받은 데이터\nX = data.X  # 데이터의 속성 역할이 feature인 경우\ny = data.Y  # 데이터의 속성 역할이 target인 경우\n\n# 다양한 기울기 값 테스트\nslopes = np.linspace(0.0, 3.0, 10)\nmse_values = []\n\nfor w in slopes:\n    predictions = w * X\n    mse = np.mean((y - predictions) ** 2)\n    mse_values.append(mse)\n\n# 결과 데이터 프레임 생성\nresults = pd.DataFrame({\n    'slope': slopes,\n    'mse': mse_values\n})\n\n# Orange Table로 변환\ndomain = Domain([ContinuousVariable('slope'),\n                 ContinuousVariable('mse')])\nout_data = Table.from_numpy(domain, results.values)", 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
