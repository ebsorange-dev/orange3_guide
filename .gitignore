# =============================================================================
# 시크릿 / 환경설정 — 절대 커밋 금지
# =============================================================================
.env
.env.*
!.env.example
!.env.gce.example
*.pem
*.key
*_credentials.json
client_secret*.json
service_account*.json

# =============================================================================
# Python
# =============================================================================
.venv/
venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.egg-info/
*.egg

# =============================================================================
# 런타임 데이터 (사용자 세션 · 캐시 · 생성물) — 소스 아님
# =============================================================================
sessions/
config/
# data/ 는 '루트' 런타임 데이터만 제외 — 앞에 / 로 앵커. (앵커 없으면 경로 어디서나
# 매칭돼 widgets_override/data/ 같은 '소스'까지 통째로 제외되는 사고 발생: owfile.py 등
# Data 카테고리 커스텀 위젯이 클론에서 누락됐던 원인. 2026-06-10 수정.)
/data/
thumbs_shared/
*.log
# Orange/도구가 남기는 ';C' 백업 디렉터리 — 소스 아님 (sessions;C 포함)
*;C/

# =============================================================================
# 대용량 콘텐츠 (교재 워크플로우/데이터셋) — >100MB 라 GitHub 푸시 거부 위험.
# 필요 시 Git LFS 또는 별도 배포로 관리.
# =============================================================================
# _upload_ows_ 는 기본 제외하되, orange3_book(교재)·orange3_data(샘플 워크플로우)만 추적 허용.
# (/* 로 '내용'을 제외해야 하위 negation 이 동작함. 154MB·최대 68MB csv, 모두
#  100MB 미만이라 직접 git 추적 가능. .pyc/__pycache__ 는 상위 규칙이 계속 제외.)
_upload_ows_/*
!_upload_ows_/orange3_book/
!_upload_ows_/orange3_data/
_upload_data_tab/

# =============================================================================
# 벤더 클론 — orange3/ 는 자체 .git 을 가진 중첩 저장소(131M). 본체는 Dockerfile 이
# pip 로 설치하므로 트리 전체는 불필요. 단, Dockerfile 이 COPY 하는 번역/오버라이드
# 파일 21개만 `git add -f` 로 추적에 포함(아래 파일들). 나머지는 모두 제외.
# =============================================================================
orange3/

# =============================================================================
# 내부 작업 노트 / 보고서 (보안 보고서 포함) — 공개 리포 노출 주의.
# 공개가 필요하면 개별적으로 add.
# =============================================================================
_md_file_/
_참조_/

# =============================================================================
# 루트 테스트 스크린샷
# =============================================================================
canvas.png
corpus_test.png

# =============================================================================
# 쿠키/세션 잔여 파일 (libcurl cookie jar 등) — 인증 토큰 포함 가능, 커밋 금지
# =============================================================================
_cook
*.cookie
cookies.txt

# =============================================================================
# 패치 스크립트가 만든 백업 — 소스 아님
# =============================================================================
*.node_id_backup
*.bak
*.orig

# =============================================================================
# IDE / OS / 에이전트
# =============================================================================
.claude/
.idea/
.vscode/
.DS_Store
Thumbs.db

# 이용 로그(런타임 JSONL) — 디렉터리만 유지
logs/*
!logs/.gitkeep

# 사용자 업로드 로딩 스플래시 (런타임)
splash_custom/*
!splash_custom/.gitkeep
