# =============================================================================
# orange3web — GCE(Linux) 배포용 환경변수 템플릿
# setup_gce.sh 가 이 파일을 .env 로 복사하고 __HOST_BASE__ 를 자동 치환한다.
# 수동 작성 시 __HOST_BASE__ 를 repo 의 절대경로로 바꿀 것 (예: /opt/orange3web).
# =============================================================================

# repo 의 절대경로. docker.sock 으로 띄우는 GUI 컨테이너의 bind 마운트에 사용된다.
# (Windows 의 /e/... 대신 리눅스 절대경로)
HOST_BASE=__HOST_BASE__

# ── Google Drive OAuth (선택) ────────────────────────────────────────────────
# 외부 IP/도메인으로 접속하므로 redirect URI 도 그에 맞춰야 한다.
# 비워두면 OPEN 모달의 LOGIN 버튼이 "연동 미설정" 으로 표시될 뿐, 나머지는 정상 동작.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://YOUR_VM_IP_OR_DOMAIN:8888/api/gdrive/callback
